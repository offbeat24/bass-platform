{
  "name": "@offbeat24/bass",
  "version": "0.3.0",
  "description": "BASS - Behavior Architecture & System Supervisor. A runtime for human-supervised AI software engineering.",
  "type": "module",
  "bin": {
    "bass": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "profiles/",
    "plugins/",
    "policies/",
    "prompt-library/",
    "registry/",
    "templates/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bass": "node dist/cli/main.js",
    "prepack": "npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "benchmark:performance": "node scripts/benchmark-performance.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run smoke:package && npm run validate:plugin && npm run benchmark:performance"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offbeat24/bass-platform.git"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
