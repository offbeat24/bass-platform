{
  "name": "bass-platform",
  "version": "0.1.1",
  "description": "BASS 0.1.1 — NAN Edition. A runtime for human-supervised AI software engineering.",
  "type": "module",
  "bin": {
    "bass": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "profiles/",
    "policies/",
    "prompt-library/",
    "registry/",
    "templates/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bass": "node dist/cli/main.js",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:nan": "npm run check:boundaries && npm test",
    "prepack": "npm run build",
    "smoke:package": "node scripts/smoke-package.mjs",
    "smoke:nan": "npm run build && node scripts/smoke-nan.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "commander": "^14.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
